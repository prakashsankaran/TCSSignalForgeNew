# ==============================================================================
# Enterprise Signal Intake Engine - Environment Template (.env.example)
# ==============================================================================

# Server Network & Host Settings
PORT=7071
SERVER_BASE_URL=http://localhost:7071
CLIENT_PORT=7070
CLIENT_ORIGIN=http://localhost:7070
CORS_ALLOWED_ORIGINS=http://localhost:7070,http://127.0.0.1:7070

# Security & AES-256-GCM Encryption Keys
TOKEN_ENCRYPTION_KEY=your-32-byte-aes256gcm-secret-key-here!!
SESSION_SECRET=your-session-secret-key-here

# Google OAuth 2.0 Credentials & API Scopes
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:7071/api/auth/google/callback
GOOGLE_GMAIL_SCOPE=https://www.googleapis.com/auth/gmail.readonly
GOOGLE_MEET_SCOPE=https://www.googleapis.com/auth/meetings.space.readonly
GMAIL_POLL_LABEL=label:FrugalForge-Candidate

# Slack API & OAuth Credentials
SLACK_API_BASE_URL=https://slack.com/api
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_USER_TOKEN=your_slack_user_token_here

# Jira REST API Integration
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# Confluence REST API Integration
CONFLUENCE_HOST=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=your-email@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token_here

# FrugalForge Enterprise Discovery Ingestion Endpoint
FRUGALFORGE_API_URL=http://localhost:7001
FRUGALFORGE_IMPORT_ENDPOINT=/api/layer0/signals/import
FRUGALFORGE_SIGNAL_API_TOKEN=your-frugalforge-bearer-token-here
FRUGALFORGE_SOURCE_ID=GoogleEnterpriseSignalPOC

# Database Storage Path
DB_PATH=../../data/signal_intake.db
