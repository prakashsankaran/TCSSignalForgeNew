# Client Dev Server Port
VITE_PORT=7070

# Backend API Server Target for Vite Dev Proxy
VITE_API_URL=http://localhost:7071

# Direct API Base URL Prefix (Leave empty to use relative /api paths with proxy)
VITE_API_BASE_URL=
